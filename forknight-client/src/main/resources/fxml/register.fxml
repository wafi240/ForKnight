<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.forknight.client.controller.RegisterController" styleClass="root">
    <VBox alignment="CENTER" spacing="15" maxWidth="400" styleClass="login-card">
        <Label text="Create Account" styleClass="label-title" />
        
        <TextField fx:id="usernameField" promptText="Username" />
        <TextField fx:id="emailField" promptText="Email" />
        <TextField fx:id="displayNameField" promptText="Display Name" />
        <PasswordField fx:id="passwordField" promptText="Password" />
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" />
        
        <Button fx:id="registerButton" text="Register" maxWidth="Infinity" onAction="#handleRegister" />
        
        <Label fx:id="errorLabel" styleClass="label-error" wrapText="true" />
        <ProgressIndicator fx:id="loadingSpinner" prefWidth="30" prefHeight="30" />
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?" />
            <Hyperlink fx:id="loginLink" text="Login" onAction="#handleLoginLink" />
        </HBox>
    </VBox>
</VBox>
