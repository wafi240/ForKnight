<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.forknight.client.controller.BalanceHistoryController" spacing="15" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Balance History" styleClass="label-title" style="-fx-font-size: 24px;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Current Balance:" style="-fx-text-fill: #9CA3AF; -fx-font-size: 16px;" />
        <Label fx:id="currentBalanceLabel" text="\$0.00" style="-fx-text-fill: #10B981; -fx-font-size: 20px; -fx-font-weight: bold;" />
        <Button text="Refresh" styleClass="button-secondary" onAction="#loadData" />
    </HBox>

    <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="180" />
            <TableColumn fx:id="colType" text="Type" prefWidth="100" />
            <TableColumn fx:id="colAmount" text="Amount" prefWidth="120" />
            <TableColumn fx:id="colItemType" text="Item Type" prefWidth="150" />
            <TableColumn fx:id="colCounterparty" text="From/To" prefWidth="150" />
        </columns>
    </TableView>
</VBox>
